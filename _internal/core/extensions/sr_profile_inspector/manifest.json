{
  "manifest_version": 3,
  "name": "srkBrowser Inspector",
  "version": "2.0.0",
  "description": "Smart Anti-Detect Profile & Proxy Status Inspector for srkBrowser",
  "permissions": ["storage", "activeTab", "browsingData"],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "srkBrowser Profile Inspector",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
